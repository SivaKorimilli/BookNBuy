# ============================================================
# BOOKNBUY - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your real keys
# NEVER commit .env.local to git
# ============================================================

# ─── NEXT.JS ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── FIREBASE (Authentication) ───────────────────────────────
# Get from: https://console.firebase.google.com → Project Settings → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ─── AMADEUS (Flights) ───────────────────────────────────────
# Get from: https://developers.amadeus.com → My Apps
# Sandbox is FREE — supports test searches
AMADEUS_CLIENT_ID=your_amadeus_client_id
AMADEUS_CLIENT_SECRET=your_amadeus_client_secret
AMADEUS_BASE_URL=https://test.api.amadeus.com   # Change to https://api.amadeus.com for production

# ─── TMDB (Movies & Shows) ───────────────────────────────────
# Get from: https://www.themoviedb.org/settings/api (FREE)
TMDB_API_KEY=your_tmdb_api_key
NEXT_PUBLIC_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p/w500

# ─── TRAINMAN API (Trains — IRCTC aggregator) ────────────────
# Apply at: https://www.trainman.in/api  (Paid, ₹999/month)
# Alternative: RailYatri API https://www.railyatri.in/api
TRAINMAN_API_KEY=your_trainman_api_key
TRAINMAN_BASE_URL=https://api.trainman.in/v1

# ─── REDBUS API (Buses) ──────────────────────────────────────
# Apply at: https://www.redbus.in/info/affiliates (Partner program)
# Alternative: Use AbhiBus API https://www.abhibus.com/api
REDBUS_API_KEY=your_redbus_api_key
REDBUS_BASE_URL=https://api.redbus.in/v1

# ─── AMAZON PA-API (Shopping) ────────────────────────────────
# Get from: https://affiliate-program.amazon.in → Product Advertising API
# Requires: Amazon Associates account (FREE)
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_PARTNER_TAG=your_associate_tag
AMAZON_REGION=us-east-1   # or ap-south-1 for India

# ─── RAZORPAY (India Payments — UPI, Cards, NetBanking) ──────
# Get from: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─── STRIPE (Global Payments) ────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── PAYPAL ──────────────────────────────────────────────────
# Get from: https://developer.paypal.com/dashboard/
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com  # Use https://api-m.paypal.com for production

# ─── ANTHROPIC (AI Assistant) ────────────────────────────────
# Get from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key

# ─── GOOGLE MAPS (Location & Maps features) ──────────────────
# Get from: https://console.cloud.google.com → APIs → Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_key
